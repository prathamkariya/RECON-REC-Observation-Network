# Copy to .env at the repo root (gitignored); docker-compose.yml reads it for
# ${VAR} substitution. Every value is optional — a blank value falls back to
# the working default in docker-compose.yml (local chain, live API).
# Never commit the copy.

# ---- Backend: analysis sources ------------------------------------------
USE_REAL_ML=false
USE_REAL_GRAPH=false
USE_REAL_WEATHER=false
USE_REAL_EXPLAIN=false
USE_REAL_LEDGER=false
ANTHROPIC_API_KEY=

# ---- Backend: on-chain registry -----------------------------------------
# Leave all four blank to use the bundled `chain` service (Hardhat, 31337).
# For Sepolia: an RPC endpoint, the deployed address, and a funded key that is
# an authorized issuer on that contract.
RPC_URL=
CONTRACT_ADDRESS=
BACKEND_PRIVATE_KEY=
CONTRACT_ABI_PATH=

# ---- Dashboard (inlined at build time — rebuild after changing) ----------
# Must be reachable from your BROWSER, e.g. http://localhost:8000 or your
# public API URL — not the in-container hostname.
NEXT_PUBLIC_API_URL=
# "true" runs the UI on its built-in demo data instead of the API.
NEXT_PUBLIC_USE_MOCK_DATA=

# Firebase web config. Leave blank to run without sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Chain the dashboard verifies against, read directly from the browser.
# Blank = the bundled local chain. For Sepolia set NEXT_PUBLIC_CHAIN_ID=11155111,
# the contract address, and your own RPC (rpc.sepolia.org is rate-limited).
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_LOCAL_RPC_URL=
