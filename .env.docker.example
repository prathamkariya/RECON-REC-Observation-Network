# Copy to `.env` (gitignored) to override any docker-compose default.
# Entirely optional — `docker compose up --build` works with none of this set,
# because every real source defaults to its mock.
#
# NOTHING SECRET BELONGS IN THE NEXT_PUBLIC_* VALUES: they are compiled into
# the JavaScript every visitor downloads. The backend's own key material
# (ANTHROPIC_API_KEY, BACKEND_PRIVATE_KEY) is read only inside the backend
# container and is never sent to a browser.

# --- Ports on the host ---
BACKEND_PORT=8000
DASHBOARD_PORT=3000

# --- Postgres ---
# Change the password before exposing this stack anywhere but your laptop.
POSTGRES_USER=recon
POSTGRES_PASSWORD=recon_dev_password
POSTGRES_DB=recon

# --- Which sources are real vs mock ---
# Turn one on only once the thing it depends on is configured:
#   USE_REAL_ML       needs nothing (reads ml/handoff/final_stat_risk.json)
#   USE_REAL_GRAPH    needs nothing (networkx ships in the image)
#   USE_REAL_WEATHER  needs outbound network access (Open-Meteo)
#   USE_REAL_EXPLAIN  needs ANTHROPIC_API_KEY
#   USE_REAL_LEDGER   needs DATABASE_URL, which compose already sets
USE_REAL_ML=false
USE_REAL_GRAPH=false
USE_REAL_WEATHER=false
USE_REAL_EXPLAIN=false
USE_REAL_LEDGER=false

# --- Claude (plain-English audit explanations) ---
ANTHROPIC_API_KEY=

# --- Timeouts: a slow upstream degrades to the heuristic, never hangs ---
WEATHER_TIMEOUT_SECONDS=3.0
EXPLAIN_TIMEOUT_SECONDS=5.0

# --- Browser origins allowed to call the API (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- On-chain REC registry (optional) ---
# Leave unset to run the whole stack off-chain. The /certificates routes need
# all three; every other route works without them.
RPC_URL=
CONTRACT_ADDRESS=
# Signs mint/retire transactions. Treat exactly like a password: never commit
# it, never paste it anywhere else, and use a throwaway testnet wallet.
BACKEND_PRIVATE_KEY=

# --- Dashboard build-time config (public, shipped to the browser) ---
# Changing any of these needs a rebuild, not just a restart:
#   docker compose up -d --build dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
# "true" runs the UI entirely off lib/mock/data.ts. Set to false once the
# backend has real certificates to serve.
NEXT_PUBLIC_USE_MOCK_DATA=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_CONTRACT_ADDRESS=
