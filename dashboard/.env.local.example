# Copy to .env.local (gitignored by Next.js's default .gitignore).
#
# Everything here is NEXT_PUBLIC_* — bundled into client JS and visible to
# anyone. Never put a backend secret, private key, or admin credential in
# this file. The backend's own RPC key / wallet key live in backend/.env,
# never here.

# FastAPI backend base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to run the whole UI against lib/mock/data.ts instead of the
# real API — lets frontend work proceed before/without the backend running.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Firebase Authentication (from your Firebase project's web app config —
# these are public client identifiers, not secrets).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Read-only Sepolia RPC for the public /verify page's optional independent
# on-chain read (wagmi/viem) — no wallet connection, no signing, ever.
# Use a public endpoint or a rate-limited read key; it will be visible in
# the browser bundle. Do NOT reuse the backend's own Alchemy/Infura key here.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# The deployed RECRegistry contract address (public on-chain info, safe to expose).
NEXT_PUBLIC_CONTRACT_ADDRESS=
