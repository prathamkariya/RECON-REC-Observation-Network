# Copy to backend/.env (gitignored) and fill in as teammates' pieces ship.
# Every flag below defaults to false/mock — the service runs with none of this set.

USE_REAL_ML=false
USE_REAL_GRAPH=false
USE_REAL_WEATHER=false
USE_REAL_EXPLAIN=false
USE_REAL_LEDGER=false

ANTHROPIC_API_KEY=
# Leave unset for local SQLite (backend/recon.db); set for shared/prod Postgres.
DATABASE_URL=

# Browser origins allowed to call this API, comma-separated. Defaults to "*"
# for local dev. Set an explicit list in any deployed environment: with "*",
# credentialed requests are disabled (per the CORS spec), and an explicit list
# re-enables them.
#   CORS_ORIGINS=http://localhost:3000,https://recon.example.com
CORS_ORIGINS=

WEATHER_TIMEOUT_SECONDS=3.0
EXPLAIN_TIMEOUT_SECONDS=5.0

# On-chain REC registry (RECRegistry.sol). Leave RPC_URL unset to default to a
# local Hardhat node (http://127.0.0.1:8545) for dev/testing.
RPC_URL=
CONTRACT_ADDRESS=
# Backend issuer wallet's private key. NEVER commit this file or paste this
# value anywhere outside your local .env — it can sign transactions on your
# behalf. Not logged and never returned by the API.
BACKEND_PRIVATE_KEY=
# Optional: override the bundled ABI with a real compiled artifact's path.
CONTRACT_ABI_PATH=
